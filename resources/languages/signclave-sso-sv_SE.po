#: src/Admin/SiteHealth.php:110
#, php-format
msgid "The %1$s IdP certificate expired on %2$s. SSO will fail until it is replaced."
msgstr "%1$s IdP-certifikat gick ut %2$s. SSO slutar fungera tills det byts."

#. translators: 1: primary or secondary, 2: expiry date
#: src/Admin/SiteHealth.php:118
#, php-format
msgid "The %1$s IdP certificate expires on %2$s (within 30 days)."
msgstr "%1$s IdP-certifikat går ut %2$s (inom 30 dagar)."

#: src/Admin/SiteHealth.php:130
msgid "IdP certificates are valid."
msgstr "IdP-certifikaten är giltiga."

#: src/Admin/SiteHealth.php:131
msgid "Pinned IdP certificates are present and not expiring within 30 days."
msgstr "Pinnade IdP-certifikat finns och går inte ut inom 30 dagar."

#: src/Admin/SiteHealth.php:138
msgid "IdP certificate needs attention."
msgstr "IdP-certifikatet behöver åtgärdas."

#: src/Admin/SiteHealth.php:155 src/Admin/SiteHealth.php:229
msgid "LDAP is not enabled."
msgstr "LDAP är inte aktiverat."

#: src/Admin/SiteHealth.php:156
msgid "LDAP fallback is off; TLS for the directory is not required."
msgstr "LDAP-fallback är av; TLS mot katalogen krävs inte."

#: src/Admin/SiteHealth.php:172
msgid "LDAP hosts use TLS or insecure LDAP is explicitly allowed."
msgstr "LDAP-värdar använder TLS, eller osäker LDAP är uttryckligen tillåten."

#: src/Admin/SiteHealth.php:173
msgid "Directory hosts are ldaps://, or “Allow ldap://” is enabled for a lab environment."
msgstr "Katalogvärdar är ldaps://, eller så är ”Tillåt ldap://” påslaget för labb."

#: src/Admin/SiteHealth.php:180
msgid "LDAP is enabled without ldaps://."
msgstr "LDAP är påslaget utan ldaps://."

#: src/Admin/SiteHealth.php:181
msgid "Use ldaps:// (or enable StartTLS on ldap://). Plaintext ldap:// without “Allow ldap://” will fail in production."
msgstr "Använd ldaps:// (eller StartTLS på ldap://). Ren ldap:// utan ”Tillåt ldap://” misslyckas i produktion."

#: src/Admin/SiteHealth.php:196
msgid "WordPress sees this request as HTTPS."
msgstr "WordPress ser den här begäran som HTTPS."

#: src/Admin/SiteHealth.php:197
msgid "Secure cookies and ACS URLs can be generated correctly."
msgstr "Säkra cookies och ACS-URL:er kan genereras korrekt."

#: src/Admin/SiteHealth.php:205
msgid "HTTPS is not detected locally; proxy headers are trusted."
msgstr "HTTPS upptäcks inte lokalt; proxy-headers är betrodda."

#: src/Admin/SiteHealth.php:206
msgid "Confirm the reverse proxy strips client-supplied X-Forwarded-* headers."
msgstr "Kontrollera att reverse proxy tar bort klientens egna X-Forwarded-*-headers."

#: src/Admin/SiteHealth.php:213
msgid "WordPress does not see HTTPS."
msgstr "WordPress ser inte HTTPS."

#: src/Admin/SiteHealth.php:214
msgid "Auth cookies may be marked insecure and the ACS URL may be http://. Terminate TLS at the web server, or enable “Trust proxy HTTPS headers” only behind a trusted reverse proxy."
msgstr "Auth-cookies kan markeras som osäkra och ACS-URL:en kan bli http://. Terminera TLS på webbservern, eller slå på ”Lita på proxy-HTTPS-headers” bara bakom en betrodd reverse proxy."

#: src/Admin/SiteHealth.php:230
msgid "SAML runs without directory verification."
msgstr "SAML körs utan katalogverifiering."

#: src/Admin/SiteHealth.php:238
msgid "LDAP is configured."
msgstr "LDAP är konfigurerat."

#: src/Admin/SiteHealth.php:246
msgid "LDAP is enabled but incomplete."
msgstr "LDAP är påslaget men ofullständigt."

#: src/Admin/SiteHealth.php:247
msgid "Fill in hosts, base DN, bind user, and bind password, or disable LDAP."
msgstr "Fyll i värdar, base DN, bind-användare och bind-lösenord, eller stäng av LDAP."

