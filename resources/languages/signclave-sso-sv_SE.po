#. Description of the plugin
#: signclave-sso.php
msgid "Secure SAML SSO + LDAP authentication for WordPress."
msgstr "Säker SAML SSO och LDAP-autentisering för WordPress."

#: resources/views/admin/settings-page.php:40
msgid "Recent SAML login rejections (ACS)"
msgstr "Senaste avvisade SAML-inloggningarna (ACS)"

#: resources/views/admin/settings-page.php:41
msgid "The SSO diagnostic test only validates the outbound AuthnRequest. These lines show why inbound SAML responses were rejected."
msgstr "SSO-diagnostiken validerar bara utgående AuthnRequest. De här raderna visar varför inkommande SAML-svar avvisades."

#: resources/views/admin/settings-page.php:48
msgid "General"
msgstr "Allmänt"

#: resources/views/admin/settings-page.php:51
msgid "Automatic SSO"
msgstr "Automatisk SSO"

#: resources/views/admin/settings-page.php:55
msgid "Redirect visits to <code>wp-login.php</code> to SAML"
msgstr "Omdirigera besök till <code>wp-login.php</code> till SAML"

#: resources/views/admin/settings-page.php:57
msgid "When on, visits go to the IdP. Local password login uses the emergency URL under Security. When off, the form stays visible and a Log in with SSO button is shown below the form."
msgstr "När på går besök till IdP:n. Lokal lösenordsinloggning använder nöd-URL:en under Säkerhet. När av visas formuläret och en Logga in med SSO-knapp under formuläret."

#: src/Saml/Handler.php:121
msgid "Log in with SSO"
msgstr "Logga in med SSO"

#: resources/views/admin/settings-page.php:61
msgid "Default role"
msgstr "Standardroll"

#: resources/views/admin/settings-page.php:71
msgid "No group match"
msgstr "Ingen gruppträff"

#: resources/views/admin/settings-page.php:75
msgid "Deny login when mappings exist and no group matches"
msgstr "Neka inloggning när mappningar finns och ingen grupp matchar"

#: resources/views/admin/settings-page.php:80
msgid "Role downgrade"
msgstr "Rollnedgradering"

#: resources/views/admin/settings-page.php:84
msgid "Remove mapped roles when the user no longer matches the group"
msgstr "Ta bort mappade roller när användaren inte längre matchar gruppen"

#: resources/views/admin/settings-page.php:86
msgid "Only roles granted by this plugin are removed. The last remaining administrator is never downgraded."
msgstr "Endast roller som pluginet har tilldelat tas bort. Den sista administratören nedgraderas aldrig."

#: resources/views/admin/settings-page.php:90
msgid "Protected logins"
msgstr "Skyddade användarnamn"

#: resources/views/admin/settings-page.php:93
msgid "One WordPress username per line. These accounts never lose the administrator role through group mapping."
msgstr "Ett WordPress-användarnamn per rad. Dessa konton förlorar aldrig administrator-rollen via gruppmappning."

#: resources/views/admin/settings-page.php:97
msgid "Role priority"
msgstr "Rollprioritet"

#: resources/views/admin/settings-page.php:100
msgid "Comma-separated role slugs, most privileged first. Used by the “highest role” strategy. Roles not listed rank below these."
msgstr "Kommaseparerade rollslugger, högst behörighet först. Används av strategin ”högsta roll”. Roller som inte listas rankas under dessa."

#: resources/views/admin/settings-page.php:107 src/Admin/SiteHealth.php:262
#: src/Admin/SiteHealth.php:263 src/Admin/SiteHealth.php:264
msgid "Security"
msgstr "Säkerhet"

#: resources/views/admin/settings-page.php:110
msgid "Strict SAML validation"
msgstr "Strikt SAML-validering"

#: resources/views/admin/settings-page.php:114
msgid "Require IdP entity ID, audience, destination, recipient, and matching AuthnRequest ID"
msgstr "Kräv IdP entity ID, audience, destination, recipient och matchande AuthnRequest-ID"

#: resources/views/admin/settings-page.php:116
msgid "Recommended. Disabling weakens assertion binding (not recommended in production)."
msgstr "Rekommenderas. Att stänga av försvagar kopplingen till assertion (rekommenderas inte i produktion)."

#: resources/views/admin/settings-page.php:120
msgid "IdP-initiated SSO"
msgstr "IdP-initierad SSO"

#: resources/views/admin/settings-page.php:124
msgid "Accept unsolicited responses without <code>InResponseTo</code>"
msgstr "Acceptera oombett svar utan <code>InResponseTo</code>"

#: resources/views/admin/settings-page.php:126
msgid "Off by default. Enabling this drops the binding to an AuthnRequest we sent, so replay protection relies on the Recipient and response ID only. Enable only if the IdP starts the login."
msgstr "Av som standard. Om det slås på tappar vi kopplingen till en AuthnRequest vi skickat, så replay-skyddet vilar bara på Recipient och svars-ID. Aktivera bara om IdP:n startar inloggningen."

#: resources/views/admin/settings-page.php:130
msgid "Clock skew tolerance"
msgstr "Tolerans för klockskevhet"

#: resources/views/admin/settings-page.php:133
msgid "seconds"
msgstr "sekunder"

#: resources/views/admin/settings-page.php:134
msgid "Allowed time drift between the IdP and this server when validating assertion validity windows. Default 60, maximum 300."
msgstr "Tillåten tidsdrift mellan IdP och den här servern vid validering av assertion-fönster. Standard 60, max 300."

#: resources/views/admin/settings-page.php:138
msgid "Trust proxy HTTPS headers"
msgstr "Lita på proxy-HTTPS-headers"

#: resources/views/admin/settings-page.php:142
msgid "Honor <code>X-Forwarded-Proto</code> / <code>X-Forwarded-SSL</code>"
msgstr "Respektera <code>X-Forwarded-Proto</code> / <code>X-Forwarded-SSL</code>"

#: resources/views/admin/settings-page.php:144
msgid "Enable only behind a trusted reverse proxy that terminates TLS."
msgstr "Aktivera bara bakom en betrodd reverse proxy som terminerar TLS."

#: resources/views/admin/settings-page.php:148
msgid "Link accounts by email"
msgstr "Länka konton via e-post"

#: resources/views/admin/settings-page.php:152
msgid "Allow LDAP password login to match existing WordPress users by email"
msgstr "Tillåt att LDAP-lösenordsinloggning matchar befintliga WordPress-användare via e-post"

#: resources/views/admin/settings-page.php:154
msgid "Off by default (OWASP). Applies to the LDAP password path only. SAML may bind to an existing user_login on first login; afterwards identity is the stored IdP NameID, never email."
msgstr "Av som standard (OWASP). Gäller bara LDAP-lösenordsvägen. SAML kan binda till befintlig user_login vid första inloggningen; därefter är identiteten sparat IdP-NameID, aldrig e-post."

#: resources/views/admin/settings-page.php:158
msgid "Emergency local login"
msgstr "Lokal nödinloggning"

#: resources/views/admin/settings-page.php:162
msgid "Secret URL for local WordPress accounts only. SAML/LDAP users cannot use it. Store securely."
msgstr "Hemlig URL endast för lokala WordPress-konton. SAML-/LDAP-användare kan inte använda den. Förvara säkert."

#: resources/views/admin/settings-page.php:164
msgid "No bypass key configured. Save settings or regenerate a key below."
msgstr "Ingen nödnyckel är konfigurerad. Spara inställningar eller generera en ny nyckel nedan."

#: resources/views/admin/settings-page.php:166
msgid "Regenerate emergency login key"
msgstr "Generera ny nödnyckel"

#: resources/views/admin/settings-page.php:170
msgid "Log retention"
msgstr "Loggretention"

#: resources/views/admin/settings-page.php:173
msgid "days"
msgstr "dagar"

#: resources/views/admin/settings-page.php:174
msgid "Audit and diagnostic log lines older than this are deleted daily. Allowed range: 7–730 days (default 90)."
msgstr "Revisions- och diagnostikloggrader äldre än detta raderas dagligen. Tillåtet intervall: 7–730 dagar (standard 90)."

#: resources/views/admin/settings-page.php:181
msgid "SAML"
msgstr "SAML"

#: resources/views/admin/settings-page.php:184
msgid "SP Entity ID"
msgstr "SP Entity ID"

#: resources/views/admin/settings-page.php:188
msgid "ACS URL"
msgstr "ACS-URL"

#: resources/views/admin/settings-page.php:192
msgid "Metadata URL"
msgstr "Metadata-URL"

#: resources/views/admin/settings-page.php:196
msgid "SP metadata"
msgstr "SP-metadata"

#: resources/views/admin/settings-page.php:198
msgid "Import this file in F5 under <strong>SAML Identity Provider → SAML SP Connectors → From Metadata</strong>. Set signing certificate to <strong>None</strong>."
msgstr "Importera filen i F5 under <strong>SAML Identity Provider → SAML SP Connectors → From Metadata</strong>. Sätt signeringscertifikat till <strong>None</strong>."

#: resources/views/admin/settings-page.php:200
msgid "Download metadata XML"
msgstr "Ladda ner metadata-XML"

#: resources/views/admin/settings-page.php:201
msgid "Copy metadata"
msgstr "Kopiera metadata"

#: resources/views/admin/settings-page.php:207
msgid "Identity Provider"
msgstr "Identitetsleverantör"

#: resources/views/admin/settings-page.php:210
msgid "Entity ID"
msgstr "Entity ID"

#: resources/views/admin/settings-page.php:214
msgid "SSO URL"
msgstr "SSO-URL"

#: resources/views/admin/settings-page.php:217
msgid "Use <code>SingleSignOnService</code> from IdP metadata, not the <code>.xml</code> metadata file URL."
msgstr "Använd <code>SingleSignOnService</code> från IdP-metadata, inte URL:en till <code>.xml</code>-metadatafilen."

#: resources/views/admin/settings-page.php:221
msgid "Group attribute"
msgstr "Gruppattribut"

#: resources/views/admin/settings-page.php:225
msgid "Username attribute"
msgstr "Användarnamnsattribut"

#: resources/views/admin/settings-page.php:229
msgid "Email attribute"
msgstr "E-postattribut"

#: resources/views/admin/settings-page.php:233
msgid "First name attribute"
msgstr "Förnamnsattribut"

#: resources/views/admin/settings-page.php:237
msgid "Last name attribute"
msgstr "Efternamnsattribut"

#: resources/views/admin/settings-page.php:241
msgid "X509 certificate (PEM)"
msgstr "X509-certifikat (PEM)"

#: resources/views/admin/settings-page.php:245
msgid "Secondary X509 certificate (PEM)"
msgstr "Sekundärt X509-certifikat (PEM)"

#: resources/views/admin/settings-page.php:248
msgid "Optional. Assertions signed with either certificate are accepted, so the IdP certificate can be rotated without downtime. Add the new certificate here, wait for the IdP to switch, then move it to the field above and clear this one."
msgstr "Valfritt. Assertions signerade med endera certifikatet accepteras, så IdP-certifikatet kan roteras utan driftstopp. Lägg det nya certifikatet här, vänta tills IdP:n bytt, flytta det sedan till fältet ovan och rensa det här."

#: resources/views/admin/settings-page.php:255
msgid "LDAP"
msgstr "LDAP"

#: resources/views/admin/settings-page.php:258
msgid "LDAP fallback"
msgstr "LDAP-fallback"

#: resources/views/admin/settings-page.php:262
msgid "Enable LDAP fallback authentication"
msgstr "Aktivera LDAP-fallbackautentisering"

#: resources/views/admin/settings-page.php:264
msgid "When enabled and fully configured, LDAP is used for password login and to verify users before WordPress creates a <strong>new</strong> account from SAML. Existing WordPress accounts can still sign in via SAML if the directory is unavailable. When disabled (or incomplete), SAML runs alone and can create users from IdP attributes."
msgstr "När det är påslaget och fullt konfigurerat används LDAP för lösenordsinloggning och för att verifiera användare innan WordPress skapar ett <strong>nytt</strong> konto från SAML. Befintliga WordPress-konton kan fortfarande logga in via SAML om katalogen är nere. När det är av (eller ofullständigt) körs SAML ensamt och kan skapa användare från IdP-attribut."

#: resources/views/admin/settings-page.php:268
msgid "Directory type"
msgstr "Katalogtyp"

#: resources/views/admin/settings-page.php:271
msgid "eDirectory"
msgstr "eDirectory"

#: resources/views/admin/settings-page.php:272
msgid "Active Directory"
msgstr "Active Directory"

#: resources/views/admin/settings-page.php:277
msgid "Hosts"
msgstr "Värdar"

#: resources/views/admin/settings-page.php:280
msgid "Comma-separated. Use <code>ldaps://host:636</code> in production."
msgstr "Kommaseparerat. Använd <code>ldaps://host:636</code> i produktion."

#: resources/views/admin/settings-page.php:284
msgid "Base DN"
msgstr "Base DN"

#: resources/views/admin/settings-page.php:288
msgid "Bind user / Bind DN"
msgstr "Bind-användare / Bind DN"

#: resources/views/admin/settings-page.php:291
msgid "The service account used for LDAP reads. Can be DN, UPN, or account name depending on your directory."
msgstr "Tjänstekontot som används för LDAP-läsning. Kan vara DN, UPN eller kontonamn beroende på katalog."

#: resources/views/admin/settings-page.php:295
msgid "Bind password"
msgstr "Bind-lösenord"

#: resources/views/admin/settings-page.php:298
msgid "Leave empty to keep existing secret."
msgstr "Lämna tomt för att behålla den sparade hemligheten."

#: resources/views/admin/settings-page.php:302
msgid "Security override"
msgstr "Säkerhetsundantag"

#: resources/views/admin/settings-page.php:306
msgid "Allow <code>ldap://</code> (not recommended)"
msgstr "Tillåt <code>ldap://</code> (rekommenderas inte)"

#: resources/views/admin/settings-page.php:311
msgid "User filter"
msgstr "Användarfilter"

#. translators: 1: %s code token, 2: typical eDirectory filter, 3: typical Active Directory filter
#: resources/views/admin/settings-page.php:319
#, php-format
msgid "Use %1$s as username placeholder. Typical eDirectory: %2$s Typical AD: %3$s"
msgstr "Använd %1$s som platshållare för användarnamn. Typiskt eDirectory: %2$s Typiskt AD: %3$s"

#: resources/views/admin/settings-page.php:331
msgid "Group attribute (eDirectory)"
msgstr "Gruppattribut (eDirectory)"

#: resources/views/admin/settings-page.php:335
msgid "Group attribute (AD)"
msgstr "Gruppattribut (AD)"

#: resources/views/admin/settings-page.php:339
msgid "Connection test"
msgstr "Anslutningstest"

#: resources/views/admin/settings-page.php:341
msgid "Test LDAP"
msgstr "Testa LDAP"

#: resources/views/admin/settings-page.php:342
msgid "Quick service bind validation for current LDAP settings."
msgstr "Snabb validering av tjänstebind mot aktuella LDAP-inställningar."

#: resources/views/admin/settings-page.php:350
msgid "Group to role mappings"
msgstr "Grupp-till-roll-mappningar"

#: resources/views/admin/settings-page.php:351
msgid "One row per mapping in format: <code>source|group|role</code>. Example: <code>ldap|cn=wp-admins,ou=groups,o=org|administrator</code>"
msgstr "En rad per mappning i formatet: <code>source|group|role</code>. Exempel: <code>ldap|cn=wp-admins,ou=groups,o=org|administrator</code>"

#: resources/views/admin/settings-page.php:356
msgid "Save settings"
msgstr "Spara inställningar"

#: resources/views/admin/settings-page.php:361
msgid "Diagnostics"
msgstr "Diagnostik"

#: resources/views/admin/settings-page.php:362
msgid "Use this for technical validation. Password is never written to logs."
msgstr "Används för teknisk validering. Lösenord skrivs aldrig till loggar."

#: resources/views/admin/settings-page.php:365
msgid "Test username"
msgstr "Testanvändarnamn"

#: resources/views/admin/settings-page.php:369
msgid "Test password"
msgstr "Testlösenord"

#: resources/views/admin/settings-page.php:373
msgid "Run tests"
msgstr "Kör tester"

#: resources/views/admin/settings-page.php:375
msgid "Test LDAP auth"
msgstr "Testa LDAP-auth"

#: resources/views/admin/settings-page.php:376
